{
  "name": "ai-website-clone-template",
  "version": "0.3.1",
  "private": true,
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --webpack --hostname 127.0.0.1 --port 3001",
    "build": "node node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3001",
    "cron:refresh-due": "node scripts/run-refresh-due.mjs",
    "worker:refresh-due": "node scripts/run-refresh-due-worker.mjs",
    "playwright:install": "node scripts/ensure-playwright-browser.mjs",
    "postinstall": "npm run playwright:install",
    "lint": "eslint",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@next/swc-darwin-arm64": "^16.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "playwright": "^1.60.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
