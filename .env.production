# Railway production environment example
# Set real values in Railway -> Service -> Variables.

# Optional. Only set this if you intentionally proxy frontend routes to another backend.
# REMOTE_API_BASE_URL=https://your-remote-api.example.com

# Required for Kookeey-backed final URL resolution.
# KOOKEEY_PICK_API_URL=https://www.kookeey.com/pickdynamicips?...

# Recommended for protecting the Google Ads Script endpoints.
# GOOGLE_ADS_SCRIPT_TOKEN=replace-with-a-secret-token

# Recommended for protecting the scheduled refresh endpoint.
# REFRESH_SCHEDULER_TOKEN=replace-with-a-secret-token

# Recommended for protecting the dashboard and regular management APIs.
# DASHBOARD_PASSWORD=replace-with-a-password-you-remember

# Optional but recommended. If omitted, the password value is reused to sign the session cookie.
# DASHBOARD_SESSION_SECRET=replace-with-a-long-random-secret